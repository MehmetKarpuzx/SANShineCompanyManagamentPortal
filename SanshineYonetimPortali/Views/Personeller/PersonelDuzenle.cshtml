@model WebApplication4.Models.personel

@{
    ViewBag.Title = "Personel Düzenle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 style="
    background: linear-gradient(to right, #b3ecff, #e6f7ff);
    color: #007bff;
    padding: 15px 20px;
    border-radius: 8px;
    font-family: Arial, sans-serif;
    font-weight: 600;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    border-left: 5px solid #007bff;">
    Personel Düzenle
</h2>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Personel Düzenle</h4>
                </div>
                <div class="card-body">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }
                    @using (Html.BeginForm("PersonelDuzenle", "Personeller", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <!-- Primary key olan CardID alanını genellikle düzenlenemez yapabilirsiniz -->
                        <div class="form-group">
                            @Html.LabelFor(m => m.CardID, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(m => m.CardID, new { @class = "form-control", @readonly = "readonly" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.CardNo, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(m => m.CardNo, new { @class = "form-control", placeholder = "Kart No" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.RollID, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(m => m.RollID, new { @class = "form-control", placeholder = "Rol ID" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Fullname, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(m => m.Fullname, new { @class = "form-control", placeholder = "Ad Soyad" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Company, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(m => m.Company, new { @class = "form-control", placeholder = "Şirket Adı" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.CompanyID, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(m => m.CompanyID, new { @class = "form-control", placeholder = "Şirket ID" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.PhoneNumber, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "Telefon" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.MobileNumber, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(m => m.MobileNumber, new { @class = "form-control", placeholder = "Mobil" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.PhoneNumber2, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(m => m.PhoneNumber2, new { @class = "form-control", placeholder = "Telefon 2" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.EmailAdress, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(m => m.EmailAdress, new { @class = "form-control", placeholder = "Email" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Password, new { @class = "font-weight-bold" })
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Şifre" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.JobTitle, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(m => m.JobTitle, new { @class = "form-control", placeholder = "Görevi" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.WorkAdress, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(m => m.WorkAdress, new { @class = "form-control", placeholder = "İş Adresi" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Image, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(m => m.Image, new { @class = "form-control", placeholder = "Resim URL" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Website, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(m => m.Website, new { @class = "form-control", placeholder = "Web Sitesi" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Logo, new { @class = "font-weight-bold" })
                            @Html.TextBoxFor(m => m.Logo, new { @class = "form-control", placeholder = "Logo URL" })
                        </div>

                        <button type="submit" class="btn btn-success">Güncelle</button>
                        @Html.ActionLink("Geri Dön", "Personeller", "Personeller", null, new { @class = "btn btn-secondary ml-2" })
                    }
                </div>
            </div>
        </div>
    </div>
</div>
